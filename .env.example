# Plantilla de configuración: copia este archivo como ".env" y ajusta los valores (el .env real no se sube al repositorio).
# Puerto en el que escucha la API.
PORT=3000
# Datos de conexión a MySQL (DB_PASSWORD es la contraseña de tu usuario de MySQL).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_medicita
# Máximo de conexiones simultáneas a la base de datos.
DB_CONNECTION_LIMIT=10
# Clave con la que se firman los tokens de sesión: debe ser larga, aleatoria y secreta.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token de sesión (2h = dos horas).
JWT_EXPIRES_IN=2h
# Rondas de cifrado de contraseñas (más alto = más seguro pero más lento).
BCRYPT_ROUNDS=10
# Segundos que se guarda en caché la lista de médicos.
CATALOG_CACHE_SECONDS=60
